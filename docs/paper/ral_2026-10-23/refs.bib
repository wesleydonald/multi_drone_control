@article{decarliDistributedNMPCCooperative,
  title = {Distributed {{NMPC}} for {{Cooperative Aerial Manipulation}} of {{Cable-Suspended Loads}}},
  author = {{de Carli}, Nicola and Belletti, Riccardo and Buzzurro, Emanuele and Testa, Andrea and Tognon, Marco},
  abstract = {In this paper, we address the problem of cooperative manipulation of a cable-suspended load by a team of aerial robots. Unlike classical approaches that rely on centralized controllers, we propose a Distributed Nonlinear Model Predictive Control (DNMPC) framework in which the UAVs communicate over a peer-to-peer network a reduced amount of variables. In the proposed method, each robot handles only a small subset of the global optimization problem. The optimal motion computed by the DNMPC loop is then used as a reference for local nonlinear controllers that track the trajectory and compute the robot’s actuation inputs. We validate the proposed scheme both through numerical simulations and real-world experiments on the FlyCrane system: a rigid platform connected to three robots by pairs of cables.},
  langid = {english},
  file = {/Users/wesleydonald/Zotero/storage/2PH7SUSB/de Carli et al. - Distributed NMPC for Cooperative Aerial Manipulation of Cable-Suspended Loads.pdf}
}

