# Install manually as /etc/udev/rules.d/99-elrs-quad.rules.
# All four adapters verified 2026-10-02; USB socket/ttyUSB numbering are irrelevant.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="FTF0AR84", SYMLINK+="QUAD1", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="FTF0AROT", SYMLINK+="QUAD2", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="FTF09R63", SYMLINK+="QUAD4", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", ATTRS{serial}=="FTF09W4A", SYMLINK+="QUAD3", GROUP="dialout", MODE="0660"
