        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.01</damping></dynamics></axis2>
      </joint>
      <joint name="cable1_j1" type="universal">
        <parent>cable1_seg2</parent>
        <child>cable1_seg1</child>
        <pose relative_to="cable1_seg1">0 0 0.050559 0 0 0</pose>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.01</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.01</damping></dynamics></axis2>
      </joint>
      <joint name="cable1_j2" type="universal">
