<sdf version="1.6">
    <model name="x3_drone0">
        <pose>0 0 0.0 0 0 0</pose>
        
        <link name="base_link">
            <enable_wind>true</enable_wind>
            <pose frame="">0 0 0 0 0 0</pose>
            <inertial>
                <pose frame="">0.0 0.0 0 0 -0 0</pose>
                <mass>0.6</mass>
                <inertia>
                    <ixx>0.001744744189</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.001400539551</iyy>
                    <iyz>0</iyz>
                    <izz>0.002782410904</izz>
                </inertia>
            </inertial>
            <collision name="base_link_inertia_collision">
                <pose frame="">0 0 0 0 0.0 0</pose>
                <geometry>
                    <box>
                        <size>0.12 0.05 0.2</size>
                    </box>
                </geometry>
            </collision>

            <visual name="base_link_inertia_visual">
                <pose frame="">0 0 -0.025 0 0.0 1.57</pose>
                <geometry>
                    <mesh>
                        <uri>file://tbs_sourceone_v5.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.15 0.15 0.15 1.0</ambient>
                    <diffuse>0.15 0.15 0.15 1.0</diffuse>
                    <specular>0.1 0.1 0.1 1.0</specular>
                </material>
            </visual>
            <sensor name="x3_drone0_imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>1000</update_rate>
                <pose>0 0 0 0 0 0</pose>
                <imu>
                    <angular_velocity>
                        <x>true</x>
                        <y>true</y>
                        <z>true</z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>true</x>
                        <y>true</y>
                        <z>true</z>
                    </linear_acceleration>
                </imu>
            </sensor>

        </link>

        <link name="rotor_0">
            <pose frame="base_link">-0.0765 -0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
        
            <visual name="rotor_0_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_0_joint" type="revolute">
            <child>rotor_0</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_1">
            <pose frame="base_link">0.0765 -0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
           
            <visual name="rotor_1_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_1_joint" type="revolute">
            <child>rotor_1</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_2">
            <pose frame="base_link">-0.0765 0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
            
            <visual name="rotor_2_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_2_joint" type="revolute">
            <child>rotor_2</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_3">
            <pose frame="base_link">0.0765 0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
            
            <visual name="rotor_3_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_3_joint" type="revolute">
            <child>rotor_3</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>
        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_nested_model_pose>true</publish_nested_model_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <update_frequency>500</update_frequency>
        </plugin>

        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone0</robotNamespace>
            <jointName>rotor_0_joint</jointName>
            <linkName>rotor_0</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>1.42e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>0</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone0</robotNamespace>
            <jointName>rotor_1_joint</jointName>
            <linkName>rotor_1</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>1.42e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>1</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone0</robotNamespace>
            <jointName>rotor_2_joint</jointName>
            <linkName>rotor_2</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>1.42e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>2</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone0</robotNamespace>
            <jointName>rotor_3_joint</jointName>
            <linkName>rotor_3</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>1.42e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>3</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>

        <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu">
        </plugin>

        <plugin
    filename="gz-sim-multicopter-velocity-control-system"
    name="gz::sim::systems::MulticopterVelocityControl">
    <robotNamespace>x3_drone0</robotNamespace>
    <commandSubTopic>cmd_vel</commandSubTopic>
    <enableSubTopic>enable</enableSubTopic>
    <comLinkName>base_link</comLinkName>
    <velocityGain>2.5 2.5 2.5</velocityGain>
    <attitudeGain>2 3 0.15</attitudeGain>
    <angularRateGain>0.4 0.52 0.18</angularRateGain>
    <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
    <rotorConfiguration>
        <rotor>
            <jointName>rotor_0_joint</jointName>
            <forceConstant>1.42e-06</forceConstant>
            <momentConstant>0.2</momentConstant>
            <direction>1</direction>
        </rotor>
        <rotor>
            <jointName>rotor_1_joint</jointName>
            <forceConstant>1.42e-06</forceConstant>
            <momentConstant>0.2</momentConstant>
            <direction>-1</direction>
        </rotor>
        <rotor>
            <jointName>rotor_2_joint</jointName>
            <forceConstant>1.42e-06</forceConstant>
            <momentConstant>0.2</momentConstant>
            <direction>-1</direction>
        </rotor>
        <rotor>
            <jointName>rotor_3_joint</jointName>
            <forceConstant>1.42e-06</forceConstant>
            <momentConstant>0.2</momentConstant>
            <direction>1</direction>
        </rotor>
    </rotorConfiguration>
</plugin>

<link name="tether">
    <!-- Cylinder center at z=0.05 (halfway up its 0.1m compressed spawn length) -->
    <!-- We spawn it SHORT (0.1m) vertically so it fits between drone and ground -->
    <!-- Use vertical orientation: no rotation needed, cylinder default is along Z -->
    <pose>0.5 0 0.05 0 1.5707963 0</pose> 
    <inertial>
        <mass>0.001</mass>
        <inertia>
            <ixx>8.35e-08</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>8.35e-08</iyy>
            <iyz>0</iyz>
            <izz>5.0e-12</izz>
        </inertia>
    </inertial>
    <collision name="tether_collision">
        <geometry>
            <cylinder>
                <radius>0.002</radius>
                <length>1.0</length>
            </cylinder>
        </geometry>
    </collision>
    <visual name="tether_visual">
        <geometry>
            <cylinder>
                <radius>0.001</radius>
                <length>1.0</length>
            </cylinder>
        </geometry>
        <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
    </visual>
</link>

<joint name="tether_to_drone" type="ball">
    <parent>base_link</parent>
    <child>tether</child>
    <!-- Joint is expressed in child (tether) frame -->
    <!-- Connect at the TOP of the tether cylinder: +0.5m along tether's Z -->
    <pose relative_to="tether">0 0 0.5 0 0 0</pose>
    <axis>
        <xyz>1 0 0</xyz>
        <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
        </limit>
        <dynamics>
            <damping>0.5</damping>
        </dynamics>
    </axis>
    <axis2>
        <xyz>0 1 0</xyz>
        <limit>
            <lower>-1.5708</lower>
            <upper>1.5708</upper>
        </limit>
        <dynamics>
            <damping>0.5</damping>
        </dynamics>
    </axis2>
</joint>

<!-- Payload sits on the ground at model origin -->
<!-- z=0.025 = half of payload height (0.05m box) so it rests on ground -->
<link name="payload">
    <gravity>1</gravity>
    <pose>1.0 0 0.025 0 0 0</pose> 
    <inertial>
        <mass>0.1</mass>
        <inertia>
            <ixx>4.17e-04</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>4.17e-04</iyy>
            <iyz>0</iyz>
            <izz>8.33e-04</izz>
        </inertia>
    </inertial>
    <collision name="payload_collision">
        <geometry>
            <box><size>0.1 0.1 0.05</size></box>
        </geometry>
    </collision>
    <visual name="payload_visual">
        <geometry>
            <box><size>0.1 0.1 0.05</size></box>
        </geometry>
        <material>
            <ambient>0.8 0.4 0.0 1</ambient>
            <diffuse>0.8 0.4 0.0 1</diffuse>
        </material>
    </visual>
</link>

<!-- Connect bottom of tether to payload top -->
<joint name="tether_to_payload" type="fixed">
    <parent>tether</parent>
    <child>payload</child>
    <!-- Bottom of tether cylinder: -0.5m along tether's Z -->
    <pose relative_to="tether">0 0 -0.5 0 0 0</pose>
</joint>

    </model>
</sdf>
