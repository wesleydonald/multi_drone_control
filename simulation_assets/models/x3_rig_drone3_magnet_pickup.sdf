<sdf version="1.6">
    <!-- Rig-twin attach newcomer (QUAD4), GENERATED by tools/make_attach_worlds.py: do not edit.
         free start: the arm spawns laid out along body +y with the magnet on the floor.
         With the pickup weld onto Tejen's ball (/pickup/*) for three_rigid_ground_rig_attach_pickup.sdf. -->
    <!-- Rig twin of x3_drone3.sdf (tools/make_carry_worlds.py): airframe with pack 0.475 kg over all links
         (base 0.435 + four 0.01 rotors), base inertia scaled by 0.435/0.6. Rod and magnet are on the rod. -->
    <model name="x3_drone3">
        <pose>0 0 0.0 0 0 0</pose>
        
        <link name="base_link">
            <enable_wind>true</enable_wind>
            <pose frame="">0 0 0 0 0 0</pose>
            <inertial>
                <pose frame="">0.0 0.0 0 0 -0 0</pose>
                <mass>0.435</mass>
                <inertia>
                    <ixx>0.001264939537</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.001015391174</iyy>
                    <iyz>0</iyz>
                    <izz>0.002017247905</izz>
                </inertia>
            </inertial>
            <collision name="base_link_inertia_collision">
                <pose frame="">0 0 0 0 0.0 0</pose>
                <geometry>
                    <box>
                        <size>0.12 0.05 0.2</size>
                    </box>
                </geometry>
            </collision>
            <!-- Wide, low landing skid so the free newcomer rests flat on the floor (no tether
                 holds it up). Contact only, no mass. Its bottom is flush with the airframe box,
                 so the newcomer rests at z 0.1 like the twin carriers (legacy: -0.12). -->
            <collision name="landing_skid_collision">
                <pose frame="">0 0 -0.08 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.3 0.3 0.04</size>
                    </box>
                </geometry>
            </collision>

            <visual name="base_link_inertia_visual">
                <pose frame="">0 0 -0.025 0 0.0 1.57</pose>
                <geometry>
                    <mesh>
                        <uri>file://tbs_sourceone_v5.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.15 0.15 0.15 1.0</ambient>
                    <diffuse>0.15 0.15 0.15 1.0</diffuse>
                    <specular>0.1 0.1 0.1 1.0</specular>
                </material>
            </visual>
            <sensor name="x3_drone3_imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>1000</update_rate>
                <pose>0 0 0 0 0 0</pose>
                <topic>x3_drone3/imu</topic>
                <imu>
                    <angular_velocity>
                        <x>true</x>
                        <y>true</y>
                        <z>true</z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>true</x>
                        <y>true</y>
                        <z>true</z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </link>

        <link name="rotor_0">
            <pose frame="base_link">-0.0765 -0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
        
            <visual name="rotor_0_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_0_joint" type="revolute">
            <child>rotor_0</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_1">
            <pose frame="base_link">0.0765 -0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
           
            <visual name="rotor_1_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_1_joint" type="revolute">
            <child>rotor_1</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_2">
            <pose frame="base_link">-0.0765 0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
            
            <visual name="rotor_2_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_2_joint" type="revolute">
            <child>rotor_2</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_3">
            <pose frame="base_link">0.0765 0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
            
            <visual name="rotor_3_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_3_joint" type="revolute">
            <child>rotor_3</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone3</robotNamespace>
            <jointName>rotor_0_joint</jointName>
            <linkName>rotor_0</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>0.62e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>0</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone3</robotNamespace>
            <jointName>rotor_1_joint</jointName>
            <linkName>rotor_1</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>0.62e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>1</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone3</robotNamespace>
            <jointName>rotor_2_joint</jointName>
            <linkName>rotor_2</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>0.62e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>2</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone3</robotNamespace>
            <jointName>rotor_3_joint</jointName>
            <linkName>rotor_3</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>0.62e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>3</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>

        <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu">
        </plugin>

        <!-- ===== MAGNET ARM (rig twin) =====
             As the twin carriers' rods: a pivot 0.04 m below the body centre, 0.55 m to the
             magnet (QUAD4 0.541-0.546 m pivot-to-plate, 8 Oct), 0.04 kg along the rod and the
             0.035 kg magnet as the tip mass. Universal joints at both ends with the legacy
             newcomer's damping (DART ignores ball damping; rod twist blocked, decisions 2026-09-27). -->
        <link name="magnet_arm">
            <pose relative_to="base_link">0 0 -0.0400 1.483412 0 0</pose>
            <inertial>
                <pose>0 0 -0.2750 0 0 0</pose>
                <mass>0.04</mass>
                <inertia><ixx>1.0083e-03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.0083e-03</iyy><iyz>0</iyz><izz>8.0000e-09</izz></inertia>
            </inertial>
            <visual name="magnet_arm_visual">
                <pose>0 0 -0.2750 0 0 0</pose>
                <geometry><cylinder><radius>0.002</radius><length>0.5500</length></cylinder></geometry>
                <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
            </visual>
        </link>
        <link name="magnet_tip_link">
            <pose relative_to="magnet_arm">0 0 -0.5500 0 0 0</pose>
            <inertial>
                <mass>0.035</mass>
                <inertia><ixx>2.0160e-06</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.0160e-06</iyy><iyz>0</iyz><izz>2.0160e-06</izz></inertia>
            </inertial>
            <collision name="magnet_tip_collision">
                <geometry><sphere><radius>0.012</radius></sphere></geometry>
                <surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface>
            </collision>
            <visual name="magnet_tip_visual">
                <geometry><sphere><radius>0.012</radius></sphere></geometry>
                <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
            </visual>
        </link>
        <joint name="arm_to_magnet_tip" type="universal">
            <parent>magnet_arm</parent>
            <child>magnet_tip_link</child>
            <axis><xyz>1 0 0</xyz><dynamics><damping>0.0001</damping></dynamics></axis>
            <axis2><xyz>0 1 0</xyz><dynamics><damping>0.0001</damping></dynamics></axis2>
        </joint>
        <joint name="base_to_magnet_arm" type="universal">
            <parent>base_link</parent>
            <child>magnet_arm</child>
            <pose>0 0 0 0 0 0</pose><!-- the pivot: the arm origin, 0.04 m below the body centre -->
            <axis><xyz>1 0 0</xyz><dynamics><damping>0.002</damping></dynamics></axis>
            <axis2><xyz>0 1 0</xyz><dynamics><damping>0.002</damping></dynamics></axis2>
        </joint>
        <!-- A top-level model: publish_model_pose adds the model's WORLD pose (the body) as the
             last PoseArray entry on /model/x3_drone3/pose; the link poses are model-relative.
             magnet_tip_link is declared last, so it is entry 0 (magnet_tip_publisher
             magnet_index 0, drone_index -1; mocap pose_index -1). -->
        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_model_pose>true</publish_model_pose>
            <publish_link_pose>true</publish_link_pose>
            <publish_nested_model_pose>false</publish_nested_model_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <update_frequency>500</update_frequency>
        </plugin>

        <!-- MAGNET WELD: /payload/attach joins the magnet tip rigidly to the shared ring
             (lift_system::payload), /payload/detach releases it. gz creates it at spawn. -->
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>magnet_tip_link</parent_link>
            <child_model>lift_system::payload</child_model>
            <child_link>body</child_link>
            <detach_topic>/payload/detach</detach_topic>
            <attach_topic>/payload/attach</attach_topic>
            <output_topic>/payload/detachable_joint_state</output_topic>
        </plugin>

        <!-- PICKUP WELD (Tejen's mission, as the partner model): the same magnet tip grabs his ball
             (tejen/payload_model.sdf). Separate topics so the ring weld and the ball weld never collide.
             gz creates it at spawn too; partner_mission.launch.py frees it (/pickup/detach). -->
        <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
            <parent_link>magnet_tip_link</parent_link>
            <child_model>payload_model</child_model>
            <child_link>payload_link</child_link>
            <detach_topic>/pickup/detach</detach_topic>
            <attach_topic>/pickup/attach</attach_topic>
            <output_topic>/pickup/detachable_joint_state</output_topic>
        </plugin>
    </model>
</sdf>
