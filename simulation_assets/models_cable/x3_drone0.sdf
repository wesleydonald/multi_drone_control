<sdf version="1.6">
    <model name="x3_drone0">
        <pose>0 0 0.0 0 0 0</pose>
        
        <link name="base_link">
            <enable_wind>true</enable_wind>
            <pose frame="">0 0 0 0 0 0</pose>
            <inertial>
                <pose frame="">0.0 0.0 0 0 -0 0</pose>
                <mass>0.6</mass>
                <inertia>
                    <ixx>0.001744744189</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.001400539551</iyy>
                    <iyz>0</iyz>
                    <izz>0.002782410904</izz>
                </inertia>
            </inertial>
            <collision name="base_link_inertia_collision">
                <pose frame="">0 0 0 0 0.0 0</pose>
                <geometry>
                    <box>
                        <size>0.12 0.05 0.2</size>
                    </box>
                </geometry>
            </collision>

            <visual name="base_link_inertia_visual">
                <pose frame="">0 0 -0.025 0 0.0 1.57</pose>
                <geometry>
                    <mesh>
                        <uri>file://tbs_sourceone_v5.stl</uri>
                        <scale>0.001 0.001 0.001</scale>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0.15 0.15 0.15 1.0</ambient>
                    <diffuse>0.15 0.15 0.15 1.0</diffuse>
                    <specular>0.1 0.1 0.1 1.0</specular>
                </material>
            </visual>
            <sensor name="x3_drone0_imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>1000</update_rate>
                <pose>0 0 0 0 0 0</pose>
                <imu>
                    <angular_velocity>
                        <x>true</x>
                        <y>true</y>
                        <z>true</z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>true</x>
                        <y>true</y>
                        <z>true</z>
                    </linear_acceleration>
                </imu>
            </sensor>

        </link>

<!-- ===================== TETHER ===================== -->
<link name="tether">
  <pose relative_to="base_link">0 0 0.5 0 0 0</pose>

  <inertial>
    <mass>0.001</mass>
    <inertia>
      <ixx>1e-6</ixx>
      <iyy>1e-6</iyy>
      <izz>1e-6</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
    </inertia>
  </inertial>

  <collision name="tether_collision">
    <geometry>
      <cylinder>
        <radius>0.002</radius>
        <length>1.0</length>
      </cylinder>
    </geometry>
  </collision>

  <visual name="tether_visual">
    <geometry>
      <cylinder>
        <radius>0.001</radius>
        <length>1.0</length>
      </cylinder>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Black</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
</link>

<!-- ===================== DRONE → TETHER JOINT ===================== -->
<joint name="tether_connection" type="revolute">
  <parent>base_link</parent>
  <child>tether</child>

  <!-- Pivot at drone -->
  <pose>0 0 0.2 0 0 0</pose>

  <!-- Allow swing (pick axis perpendicular to gravity) -->
  <axis>
    <xyz>1 0 0</xyz>

    <limit>
      <lower>-3.14159</lower>
      <upper>3.14159</upper>
    </limit>

    <dynamics>
      <damping>0.8</damping>
      <friction>0.0</friction>
    </dynamics>
  </axis>
</joint>

<!-- ===================== PAYLOAD ===================== -->
<link name="payload">
  <gravity>true</gravity>

  <inertial>
    <mass>0.1</mass>
    <inertia>
      <ixx>0.001</ixx>
      <iyy>0.001</iyy>
      <izz>0.001</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
    </inertia>
  </inertial>

  <collision name="payload_collision">
    <geometry>
      <box>
        <size>0.1 0.1 0.05</size>
      </box>
    </geometry>
  </collision>

  <visual name="payload_visual">
    <geometry>
      <box>
        <size>0.1 0.1 0.05</size>
      </box>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Black</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
</link>

<!-- ===================== TETHER → PAYLOAD JOINT ===================== -->
<joint name="tether_mass_connection" type="revolute">
  <parent>tether</parent>
  <child>payload</child>

  <pose>0 0 -0.5 0 0 0</pose>

  <axis>
    <xyz>1 0 0</xyz>

    <limit>
      <lower>-3.14159</lower>
      <upper>3.14159</upper>
    </limit>

    <dynamics>
      <damping>0.5</damping>
      <friction>0.0</friction>
    </dynamics>
  </axis>
</joint>

        <link name="rotor_0">
            <pose frame="base_link">-0.0765 -0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
        
            <visual name="rotor_0_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_0_joint" type="revolute">
            <child>rotor_0</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_1">
            <pose frame="base_link">0.0765 -0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
           
            <visual name="rotor_1_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_ccw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_1_joint" type="revolute">
            <child>rotor_1</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_2">
            <pose frame="base_link">-0.0765 0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
            
            <visual name="rotor_2_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_2_joint" type="revolute">
            <child>rotor_2</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>

        <link name="rotor_3">
            <pose frame="base_link">0.0765 0.083 0 0 0 0</pose>
            <inertial>
                <pose frame="">0 0 0 0 -0 0</pose>
                <mass>0.01</mass>
                <inertia>
                    <ixx>9.75e-08</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>4.17041e-06</iyy>
                    <iyz>0</iyz>
                    <izz>4.26041e-06</izz>
                </inertia>
            </inertial>
            
            <visual name="rotor_3_visual">
                <pose frame="">0 0 0 0 -0 0</pose>
                <geometry>
                    <mesh>
                        <scale>0.05 0.05 0.05</scale>
                        <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/x3 uav/4/files/meshes/propeller_cw.dae</uri>
                    </mesh>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                </material>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name="rotor_3_joint" type="revolute">
            <child>rotor_3</child>
            <parent>base_link</parent>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1e+16</lower>
                    <upper>1e+16</upper>
                </limit>
                <dynamics>
                    <spring_reference>0</spring_reference>
                    <spring_stiffness>0</spring_stiffness>
                </dynamics>
                <use_parent_model_frame>1</use_parent_model_frame>
            </axis>
        </joint>
        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
            <publish_link_pose>true</publish_link_pose>
            <publish_nested_model_pose>true</publish_nested_model_pose>
            <use_pose_vector_msg>true</use_pose_vector_msg>
            <update_frequency>500</update_frequency>
        </plugin>

        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone0</robotNamespace>
            <jointName>rotor_0_joint</jointName>
            <linkName>rotor_0</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>1.42e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>0</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone0</robotNamespace>
            <jointName>rotor_1_joint</jointName>
            <linkName>rotor_1</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
            <motorConstant>1.42e-06</motorConstant>
            <momentConstant>0.2</momentConstant>
            <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
            <actuator_number>1</actuator_number>
            <rotorDragCoefficient>0.0</rotorDragCoefficient>
            <rollingMomentCoefficient>0.0</rollingMomentCoefficient>
            <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
            <motorType>velocity</motorType>
        </plugin>
        <plugin
            filename="gz-sim-multicopter-motor-model-system"
            name="gz::sim::systems::MulticopterMotorModel">
            <robotNamespace>x3_drone0</robotNamespace>
            <jointName>rotor_2_joint</jointName>
            <linkName>rotor_2</linkName>
            <turningDirection>ccw</turningDirection>
            <timeConstantUp>0.02</timeConstantUp>
            <timeConstantDown>0.02</timeConstantDown>
            <maxRotVelocity>4631.0</maxRotVelocity>
