        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
          <publish_link_pose>true</publish_link_pose>
          <publish_nested_model_pose>true</publish_nested_model_pose>
          <use_pose_vector_msg>true</use_pose_vector_msg>
          <update_frequency>500</update_frequency>
        </plugin>
      </model>

      <!-- ===== TETHER 0: payload -> drone0 (rigid, len=0.5000, detach@payload) ===== -->
      <link name="stub_pay_0">
        <pose>-0.216506 0.125000 0.050000 0 0.000000 3.141593</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz></inertia>
        </inertial>
      </link>
      <joint name="payload_to_stub_0" type="ball">
        <parent>payload::body</parent>
        <child>stub_pay_0</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <model name="tether_0">
        <pose>0 0 0 0 0 0</pose>
        <link name="rod">
        <pose>-0.431927 0.249373 0.075000 0 1.470629 2.617994</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>2.083e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-05</iyy><iyz>0</iyz><izz>8.000e-09</izz>
          </inertia>
        </inertial>
        <visual name="tether_0_visual">
          <geometry><cylinder><radius>0.004</radius><length>0.5000</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        </link>
      </model>
      <joint name="tether_0_to_drone0" type="ball">
        <parent>tether_0::rod</parent>
        <child>x3_drone0::base_link</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <!-- ===== TETHER 1: payload -> drone1 (rigid, len=0.5000, detach@payload) ===== -->
      <link name="stub_pay_1">
        <pose>-0.000000 -0.250000 0.050000 0 0.000000 3.141593</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz></inertia>
        </inertial>
      </link>
      <joint name="payload_to_stub_1" type="ball">
        <parent>payload::body</parent>
        <child>stub_pay_1</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <model name="tether_1">
        <pose>0 0 0 0 0 0</pose>
        <link name="rod">
        <pose>-0.000000 -0.498747 0.075000 0 1.470629 -1.570797</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>2.083e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-05</iyy><iyz>0</iyz><izz>8.000e-09</izz>
          </inertia>
        </inertial>
        <visual name="tether_1_visual">
          <geometry><cylinder><radius>0.004</radius><length>0.5000</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        </link>
      </model>
      <joint name="tether_1_to_drone1" type="ball">
        <parent>tether_1::rod</parent>
        <child>x3_drone1::base_link</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <!-- ===== TETHER 2: payload -> drone2 (rigid, len=0.5000, detach@payload) ===== -->
      <link name="stub_pay_2">
        <pose>0.216506 0.125000 0.050000 0 0.000000 3.141593</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz></inertia>
        </inertial>
      </link>
      <joint name="payload_to_stub_2" type="ball">
        <parent>payload::body</parent>
        <child>stub_pay_2</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <model name="tether_2">
        <pose>0 0 0 0 0 0</pose>
        <link name="rod">
        <pose>0.431927 0.249373 0.075000 0 1.470629 0.523599</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>2.083e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-05</iyy><iyz>0</iyz><izz>8.000e-09</izz>
          </inertia>
        </inertial>
        <visual name="tether_2_visual">
          <geometry><cylinder><radius>0.004</radius><length>0.5000</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        </link>
      </model>
      <joint name="tether_2_to_drone2" type="ball">
        <parent>tether_2::rod</parent>
        <child>x3_drone2::base_link</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <!-- ===== DETACH 0: release cable+drone0 from the payload (payload left clean) ===== -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>stub_pay_0</parent_link>
        <child_model>tether_0</child_model>
        <child_link>rod</child_link>
        <detach_topic>/drone_0/detach</detach_topic>
        <attach_topic>/drone_0/attach</attach_topic>
        <output_topic>/drone_0/detachable_joint_state</output_topic>
      </plugin>
      <!-- ===== DETACH 1: release cable+drone1 from the payload (payload left clean) ===== -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>stub_pay_1</parent_link>
        <child_model>tether_1</child_model>
        <child_link>rod</child_link>
        <detach_topic>/drone_1/detach</detach_topic>
        <attach_topic>/drone_1/attach</attach_topic>
        <output_topic>/drone_1/detachable_joint_state</output_topic>
      </plugin>
      <!-- ===== DETACH 2: release cable+drone2 from the payload (payload left clean) ===== -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>stub_pay_2</parent_link>
        <child_model>tether_2</child_model>
        <child_link>rod</child_link>
        <detach_topic>/drone_2/detach</detach_topic>
        <attach_topic>/drone_2/attach</attach_topic>
        <output_topic>/drone_2/detachable_joint_state</output_topic>
      </plugin>
    </model>

    <!-- ===== TAKEOFF PLATFORMS (rest the drones at spawn until TAKEOFF) ===== -->

    <!-- ===== APPROACH DRONE (free flyer with a magnet arm) =====
         A 4th drone, x3_drone3, spawned to the side and NOT tethered. It carries a 0.5 m
         magnet arm (see models/x3_drone3_magnet.sdf); once airborne it flies to the payload
         and, on /payload/attach, its magnet welds to the shared lift_system payload so it
         becomes the 4th load-bearing member of the dissipative fleet. It rests on the ground
         at spawn (magnet arm flops via its universal joint) and lifts on TAKEOFF.

         SPAWNED ON THE 6 O'CLOCK BISECTOR (-y). The tethers sit at 4/12/8 o'clock (azimuth
         330/90/210 deg, 2026-09-10: the three attach points straddle the centre of mass so
         the three-drone hover hangs level, unlike 3/12/9) and the newcomer welds at
         6 o'clock (attach_y_offset -0.25) in the 120 deg gap between 4 and 8, which is
         centred on -y so the approach descends it clear of every tether. -->
    <include>
      <uri>models/x3_drone3_magnet_rod_partner_attached_uu.sdf</uri>
      <name>x3_drone3</name>
      <pose>0.000000 0.747494 0.100000 0 0 0</pose>
    </include>


    <!-- pickup object for the partner mission, on the floor clear of the ring -->
    <include>
      <uri>tejen/payload_model.sdf</uri>
      <pose>1.2 -1.4 0.08 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>500</update_frequency>
      </plugin>
    </include>
  </world>
</sdf>
