<?xml version="1.0" ?>
<!-- three_attach_partner.sdf rotated 180 deg: carriers on plates 5/9/1 (150/270/30 deg), drone 3 (magnet partner) WELDED on plate 3 (90 deg) from spawn. The partner demo start (Wesley 2026-09-26: all four attached, plate 3 leaves and rejoins). -->
<sdf version="1.6">
  <!-- three_attach_rod.sdf + the partner pickup object + a pickup weld on drone 3 (2026-09-25) -->
  <world name="quadcopter">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <scene><background>0.6 0.8 1.0 1</background><ambient>0.5 0.5 0.5 1</ambient></scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><surface><contact><collide_bitmask>0x01</collide_bitmask></contact></surface></collision><!-- bit 0x01: the partner net (0x02) passes through the floor -->
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="lift_system" canonical_link="anchor">
      <pose>0 0 0 0 0 0</pose>
      <!-- WORLD-FIXED ANCHOR: nested poses publish in the WORLD frame. -->
      <link name="anchor">
        <inertial><mass>0.001</mass>
          <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
        </inertial>
      </link>
      <joint name="anchor_to_world" type="fixed"><parent>world</parent><child>anchor</child></joint>

      <!-- ===== DRONES (elevated, taut rigid cables) ===== -->
      <include>
        <uri>models/x3_drone0.sdf</uri>
        <name>x3_drone0</name>
        <pose>-0.647349 0.373747 0.100000 0 0.000000 0.000000</pose>
      </include>
      <include>
        <uri>models/x3_drone1.sdf</uri>
        <name>x3_drone1</name>
        <pose>-0.000000 -0.747494 0.100000 0 0.000000 0.000000</pose>
      </include>
      <include>
        <uri>models/x3_drone2.sdf</uri>
        <name>x3_drone2</name>
        <pose>0.647349 0.373747 0.100000 0 0.000000 0.000000</pose>
      </include>

      <!-- ===== PAYLOAD: 500 mm ring, 12 magnet plates every 30 deg on the top face, plate 0 on +x (m2a_ring_fixture.sdf) ===== -->
      <model name="payload">
        <pose>0.000000 0.000000 0.025000 0 0 0.000000</pose>
        <link name="body">
          <gravity>1</gravity>
          <inertial><mass>0.86</mass>
            <inertia><ixx>2.733e-02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>2.733e-02</iyy><iyz>0</iyz><izz>5.452e-02</izz></inertia>
          </inertial>
          <!-- partner world only (Wesley 2026-09-26: the real ring has a net across the
               inner circle): annulus r 0.20-0.28 at the old disc height + a shallow net
               cone (8 cm sag to a flat centre patch). Collision/visual only, no mass.
               The net collides only with bitmask 0x02 (the ball, all 0xffff), not the floor
               (0x01), so it may sag below the ring's resting height. Replaces the solid disc (R0625: the ball rolled off). -->
          <collision name="ring_annulus_0"><pose>0.2400 0.0000 0.005 0 0 0.0000</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_1"><pose>0.2217 0.0918 0.005 0 0 0.3927</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_2"><pose>0.1697 0.1697 0.005 0 0 0.7854</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_3"><pose>0.0918 0.2217 0.005 0 0 1.1781</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_4"><pose>0.0000 0.2400 0.005 0 0 1.5708</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_5"><pose>-0.0918 0.2217 0.005 0 0 1.9635</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_6"><pose>-0.1697 0.1697 0.005 0 0 2.3562</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_7"><pose>-0.2217 0.0918 0.005 0 0 2.7489</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_8"><pose>-0.2400 0.0000 0.005 0 0 3.1416</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_9"><pose>-0.2217 -0.0918 0.005 0 0 3.5343</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_10"><pose>-0.1697 -0.1697 0.005 0 0 3.9270</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_11"><pose>-0.0918 -0.2217 0.005 0 0 4.3197</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_12"><pose>-0.0000 -0.2400 0.005 0 0 4.7124</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_13"><pose>0.0918 -0.2217 0.005 0 0 5.1051</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_14"><pose>0.1697 -0.1697 0.005 0 0 5.4978</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="ring_annulus_15"><pose>0.2217 -0.0918 0.005 0 0 5.8905</pose><geometry><box><size>0.080 0.1154 0.030</size></box></geometry></collision>
          <collision name="net_0"><pose>0.1250 0.0000 -0.0220 0 -0.4900 0.0000</pose><geometry><box><size>0.1740 0.0836 0.004</size></box></geometry><surface><contact><collide_bitmask>0x02</collide_bitmask></contact></surface></collision>
          <visual name="net_0_visual"><pose>0.1250 0.0000 -0.0220 0 -0.4900 0.0000</pose><geometry><box><size>0.1740 0.0836 0.002</size></box></geometry><material><ambient>0.9 0.9 0.9 0.35</ambient><diffuse>0.9 0.9 0.9 0.35</diffuse></material><transparency>0.6</transparency></visual>
