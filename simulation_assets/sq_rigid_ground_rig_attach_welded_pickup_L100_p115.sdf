        <detach_topic>/drone_1/detach</detach_topic>
        <attach_topic>/drone_1/attach</attach_topic>
        <output_topic>/drone_1/detachable_joint_state</output_topic>
      </plugin>
      <!-- ===== DETACH 2: release cable+drone2 from the payload (payload left clean) ===== -->
      <plugin filename="gz-sim-detachable-joint-system"
