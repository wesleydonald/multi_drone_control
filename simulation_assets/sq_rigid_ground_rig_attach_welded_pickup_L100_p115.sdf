          <geometry><sphere><radius>0.012</radius></sphere></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
        </link>
      </model>
      <joint name="tether_0_to_drone0" type="ball">
        <parent>tether_0::rod</parent>
        <child>x3_drone0::base_link</child>
        <pose>0 0 -0.040000 0 0 0</pose>
