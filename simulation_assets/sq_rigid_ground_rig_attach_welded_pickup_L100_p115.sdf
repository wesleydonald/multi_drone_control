    <!-- ===== TAKEOFF PLATFORMS (rest the drones at spawn until TAKEOFF) ===== -->

    <!-- ===== NEWCOMER (QUAD4 = /drone_3): a free rig-twin drone with a 1.0 m magnet rod =====
         Standalone, not in lift_system: its poses are on /model/x3_drone3/pose.
         Welded start: welded on rig plate 9 (90 deg) from spawn, the tip on the plate top
         and the rod at the carriers' ground-start elevation; the magnet manager
         starts attached (attached_at_start).
         The pickup weld onto the pickup plate forms at spawn too; partner_mission.launch.py frees it
         (/pickup/detach) before his mission. -->
    <include>
      <uri>models/x3_rig_drone3_magnet_welded_pickup_L100_p115.sdf</uri>
      <name>x3_drone3</name>
      <pose>0.000000 1.203758 0.100000 0 0 0</pose>
    </include>

    <!-- ===== THE PICKUP PLATE: his pickup object (models/rig_pickup_plate.sdf, 100 x 100 x 25 mm, 0.15 kg, bitmask 0x05) =====
         On the floor at (1.6, 2.0), resting flat on its face: 1.79 m beside QUAD4's body and rod (welded),
         2.04 m from the nearest carrier. His object magnet welds it to QUAD4's tip (/pickup/attach) and
         drops it into the ring's net (/pickup/detach). /model/payload_model/pose: [link, model]. -->
    <include>
      <uri>models/rig_pickup_plate.sdf</uri>
      <pose>1.600000 2.000000 0.012500 0 0 0</pose>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>500</update_frequency>
      </plugin>
    </include>
  </world>
</sdf>
