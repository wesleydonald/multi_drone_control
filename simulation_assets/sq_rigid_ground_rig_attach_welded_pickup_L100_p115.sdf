      <!-- ===== TETHER 0: payload -> drone0 (rigid, len=1.0000, detach@payload) ===== -->
      <link name="stub_pay_0">
        <pose>0.204000 0.000000 0.038000 0 0 0</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz></inertia>
        </inertial>
      </link>
      <joint name="payload_to_stub_0" type="ball">
        <parent>payload::body</parent>
        <child>stub_pay_0</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <model name="tether_0">
        <pose>0 0 0 0 0 0</pose>
        <link name="rod">
        <pose>0.703879 0.000000 0.049000 0 1.548795 0.000000</pose>
        <inertial>
          <pose>0 0 -0.233333 0 0 0</pose>
          <mass>0.075</mass>
          <inertia>
            <ixx>8.000e-03</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>8.000e-03</iyy><iyz>0</iyz><izz>3.200e-07</izz>
          </inertia>
        </inertial>
        <visual name="tether_0_visual">
