<sdf version="1.6">
  <!-- G1b test copy: 0.1 kg (Wesley 2026-09-26), solid-sphere inertia 2/5 m r^2 for the 0.08 m sim geometry
       (the real ~0.1 kg steel ball is ~0.029 m across; geometry kept) -->
  <model name="payload_model">
    <pose>0 0 0 0 0 0</pose>

    <link name="payload_link">
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>2.56e-4</ixx>
          <iyy>2.56e-4</iyy>
          <izz>2.56e-4</izz>
        </inertia>
      </inertial>

      <visual name="payload_visual">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.8 0.2 0.2 1</ambient>
          <diffuse>0.8 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <collision name="payload_collision">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <!-- <include>
      <uri>payload_model.sdf</uri>
      <pose>0 0 0.08 0 0 0</pose>

      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>500</update_frequency>
      </plugin>
    </include> -->
  </model>
</sdf>