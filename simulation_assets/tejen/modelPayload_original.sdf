        <link name="tether_rod">
            <pose relative_to="X3/base_link">0 0 0  0 0 0</pose>
            <inertial>
                <mass>1e-4</mass>
                <inertia>
                <ixx>1e-8</ixx><iyy>1e-8</iyy><izz>1e-8</izz>
                <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
                </inertia>
            </inertial>
            <visual name="rod_vis">
                <pose>0 0 -0.2 0 0 0</pose><geometry><cylinder><radius>0.001</radius><length>0.42</length></cylinder></geometry>
            </visual>
            <collision name="rod_col">
                <pose>0 0 -0.2 0 0 0</pose><geometry><cylinder><radius>0.001</radius><length>0.42</length></cylinder></geometry>
            </collision>
            </link>

            <link name="payload">
            <pose relative_to="tether_rod">0 0 -0.42  0 0 0</pose>
            <visual name="payload_vis">
                <geometry>
                <sphere><radius>0.01</radius></sphere>
                </geometry>
                <pose>0 0 0 0 0 0</pose>
            </visual>
            <collision name="payload_col">
                <geometry><sphere><radius>0.01</radius></sphere></geometry>
                <pose>0 0 0 0 0 0</pose>
            </collision>
            <inertial>
                <mass>0.045</mass>
                <pose>0 0 0 0 0 0</pose>
                <inertia>
                <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
                <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
                </inertia>
            </inertial>
            </link>

            
            <joint name="base_to_rod" type="universal">
            <parent>X3/base_link</parent>
            <child>tether_rod</child>
            <pose relative_to="X3/base_link">0 0 0  0 0 0</pose>

            
            <axis>
                <xyz>1 0 0</xyz>
                <limit>
                <lower>-1.5</lower>  
                <upper> 1.5</upper>  
                </limit>
                <dynamics><damping>0.001</damping></dynamics>
            </axis>

            
            <axis2>
                <xyz>0 1 0</xyz>
                <limit>
                <lower>-1.5</lower>  
                <upper> 1.5</upper>  
                </limit>
                <dynamics><damping>0.001</damping></dynamics>
            </axis2>
            </joint>

            
            <joint name="rod_to_payload" type="fixed">
            <parent>tether_rod</parent>
            <child>payload</child>
            <pose>0 0 0  0 0 0</pose>
            </joint>

</model>
