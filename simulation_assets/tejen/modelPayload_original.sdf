<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
    <model name="x3">
        <pose>0 0 0.1 0 0 0</pose>
        <link name="X3/base_link">
            <pose>0 0 0 0 0 0</pose>
            <inertial>
                <pose>0 0 0.015 0 0 0</pose>
                <mass>0.56</mass>
                <inertia>
                    <ixx>0.001744744189</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.001400539551</iyy>
                    <iyz>0</iyz>
