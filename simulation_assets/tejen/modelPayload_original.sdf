                    <linear_acceleration>
                        <x>true</x>
                        <y>true</y>
                        <z>true</z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </link>


        <link name="X3/rotor_0">
            <pose relative_to="X3/base_link">-0.0865 -0.073 0 0 0 0</pose>
            <inertial>
