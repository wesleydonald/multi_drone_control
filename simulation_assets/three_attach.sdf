<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="quadcopter">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <scene><background>0.6 0.8 1.0 1</background><ambient>0.5 0.5 0.5 1</ambient></scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.3 0.6 0.3 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      </link>
    </model>

    <model name="lift_system" canonical_link="anchor">
      <pose>0 0 0 0 0 0</pose>
      <!-- WORLD-FIXED ANCHOR: nested poses publish in the WORLD frame. -->
      <link name="anchor">
        <inertial><mass>0.001</mass>
          <inertia><ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz></inertia>
        </inertial>
      </link>
      <joint name="anchor_to_world" type="fixed"><parent>world</parent><child>anchor</child></joint>

      <!-- ===== DRONES (elevated, taut rigid cables) ===== -->
      <include>
        <uri>models/x3_drone0.sdf</uri>
        <name>x3_drone0</name>
        <pose>0.577494 0.000000 0.100000 0 0 0</pose>
      </include>
      <include>
        <uri>models/x3_drone1.sdf</uri>
        <name>x3_drone1</name>
        <pose>-0.288747 0.500124 0.100000 0 0 0</pose>
      </include>
      <include>
        <uri>models/x3_drone2.sdf</uri>
        <name>x3_drone2</name>
        <pose>-0.288747 -0.500124 0.100000 0 0 0</pose>
      </include>

      <!-- ===== PAYLOAD ===== -->
      <model name="payload">
        <pose>0 0 0.025 0 0 0</pose>
        <link name="body">
          <gravity>1</gravity>
          <inertial><mass>0.4</mass>
            <inertia><ixx>1.67e-03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1.67e-03</iyy><iyz>0</iyz><izz>3.33e-03</izz></inertia>
          </inertial>
          <collision name="collision"><geometry><box><size>0.2 0.2 0.05</size></box></geometry></collision>
          <visual name="visual"><geometry><box><size>0.2 0.2 0.05</size></box></geometry>
            <material><ambient>0.8 0.4 0.0 1</ambient><diffuse>0.8 0.4 0.0 1</diffuse></material>
          </visual>
        </link>
        <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
          <publish_link_pose>true</publish_link_pose>
          <publish_nested_model_pose>true</publish_nested_model_pose>
          <use_pose_vector_msg>true</use_pose_vector_msg>
          <update_frequency>500</update_frequency>
        </plugin>
      </model>

      <!-- ===== TETHER 0: payload -> drone0 (rigid, len=0.5000, detach@payload) ===== -->
      <link name="stub_pay_0">
        <pose>0.080000 0.000000 0.050000 0 0 0</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz></inertia>
        </inertial>
      </link>
      <joint name="payload_to_stub_0" type="ball">
        <parent>payload::body</parent>
        <child>stub_pay_0</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <model name="tether_0">
        <pose>0 0 0 0 0 0</pose>
        <link name="rod">
        <pose>0.328747 0.000000 0.075000 0 1.470629 0.000000</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>2.083e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-05</iyy><iyz>0</iyz><izz>8.000e-09</izz>
          </inertia>
        </inertial>
        <visual name="tether_0_visual">
          <geometry><cylinder><radius>0.004</radius><length>0.5000</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        </link>
      </model>
      <joint name="tether_0_to_drone0" type="ball">
        <parent>tether_0::rod</parent>
        <child>x3_drone0::base_link</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <!-- ===== TETHER 1: payload -> drone1 (rigid, len=0.5000, detach@payload) ===== -->
      <link name="stub_pay_1">
        <pose>-0.040000 0.069282 0.050000 0 0 0</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz></inertia>
        </inertial>
      </link>
      <joint name="payload_to_stub_1" type="ball">
        <parent>payload::body</parent>
        <child>stub_pay_1</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <model name="tether_1">
        <pose>0 0 0 0 0 0</pose>
        <link name="rod">
        <pose>-0.164373 0.284703 0.075000 0 1.470629 2.094395</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>2.083e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-05</iyy><iyz>0</iyz><izz>8.000e-09</izz>
          </inertia>
        </inertial>
        <visual name="tether_1_visual">
          <geometry><cylinder><radius>0.004</radius><length>0.5000</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        </link>
      </model>
      <joint name="tether_1_to_drone1" type="ball">
        <parent>tether_1::rod</parent>
        <child>x3_drone1::base_link</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <!-- ===== TETHER 2: payload -> drone2 (rigid, len=0.5000, detach@payload) ===== -->
      <link name="stub_pay_2">
        <pose>-0.040000 -0.069282 0.050000 0 0 0</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia><ixx>1e-8</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-8</iyy><iyz>0</iyz><izz>1e-8</izz></inertia>
        </inertial>
      </link>
      <joint name="payload_to_stub_2" type="ball">
        <parent>payload::body</parent>
        <child>stub_pay_2</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <model name="tether_2">
        <pose>0 0 0 0 0 0</pose>
        <link name="rod">
        <pose>-0.164373 -0.284703 0.075000 0 1.470629 -2.094395</pose>
        <inertial>
          <mass>0.001</mass>
          <inertia>
            <ixx>2.083e-05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>2.083e-05</iyy><iyz>0</iyz><izz>8.000e-09</izz>
          </inertia>
        </inertial>
        <visual name="tether_2_visual">
          <geometry><cylinder><radius>0.004</radius><length>0.5000</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        </link>
      </model>
      <joint name="tether_2_to_drone2" type="ball">
        <parent>tether_2::rod</parent>
        <child>x3_drone2::base_link</child>
        <axis><xyz>1 0 0</xyz><dynamics><damping>0.1</damping></dynamics></axis>
        <axis2><xyz>0 1 0</xyz><dynamics><damping>0.1</damping></dynamics></axis2>
      </joint>
      <!-- ===== DETACH 0: release cable+drone0 from the payload (payload left clean) ===== -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>stub_pay_0</parent_link>
        <child_model>tether_0</child_model>
        <child_link>rod</child_link>
        <detach_topic>/drone_0/detach</detach_topic>
        <attach_topic>/drone_0/attach</attach_topic>
        <output_topic>/drone_0/detachable_joint_state</output_topic>
      </plugin>
      <!-- ===== DETACH 1: release cable+drone1 from the payload (payload left clean) ===== -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>stub_pay_1</parent_link>
        <child_model>tether_1</child_model>
        <child_link>rod</child_link>
        <detach_topic>/drone_1/detach</detach_topic>
        <attach_topic>/drone_1/attach</attach_topic>
        <output_topic>/drone_1/detachable_joint_state</output_topic>
      </plugin>
      <!-- ===== DETACH 2: release cable+drone2 from the payload (payload left clean) ===== -->
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>stub_pay_2</parent_link>
        <child_model>tether_2</child_model>
        <child_link>rod</child_link>
        <detach_topic>/drone_2/detach</detach_topic>
        <attach_topic>/drone_2/attach</attach_topic>
        <output_topic>/drone_2/detachable_joint_state</output_topic>
      </plugin>
    </model>

    <!-- ===== APPROACH DRONE (free flyer with a magnet arm) =====
         A 4th drone, x3_drone3, spawned to the side and NOT tethered. It carries a 0.5 m
         magnet arm (see models/x3_drone3_magnet.sdf); once airborne it flies to the payload
         and, on /payload/attach, its magnet welds to the shared lift_system payload so it
         becomes the 4th load-bearing member of the dissipative fleet. It rests on the ground
         at spawn (magnet arm flops via its universal joint) and lifts on TAKEOFF. -->
    <include>
      <uri>models/x3_drone3_magnet.sdf</uri>
      <name>x3_drone3</name>
      <pose>1.2 0.0 0.12 0 0 0</pose>
    </include>

  </world>
</sdf>
