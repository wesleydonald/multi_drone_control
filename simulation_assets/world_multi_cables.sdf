      <link name="base_link_2">
        <pose>0.0 1.0 0.1 0 0 0</pose>
        <enable_wind>true</enable_wind>
        <inertial>
          <mass>0.6</mass>
          <inertia>
            <ixx>0.001744744189</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001400539551</iyy><iyz>0</iyz>
            <izz>0.002782410904</izz>
