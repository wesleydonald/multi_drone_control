<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tejen_mission</name>
  <version>0.0.0</version>
  <description>Drone communication and simulation helper nodes.</description>
  <maintainer email="mitch.torok@gmail.com">mitchell</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>trajectory_msgs</depend>

  <!-- Cross-package runtimes started by the M2C launch.  Do not add
       tejen_dynamic_planner here: that package already depends on
       tejen_mission and the reverse edge recreates a colcon cycle. -->
  <exec_depend>mpc_planner</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>simulation_communication</exec_depend>
  <exec_depend>tejen_mpc</exec_depend>
  <exec_depend>drone_visualisation</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
