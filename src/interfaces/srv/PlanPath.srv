# Request — start and goal positions
float64 start_x
float64 start_y
float64 start_z
float64 goal_x
float64 goal_y
float64 goal_z
float64 cruise_speed
float64 dt
float64 wind_map_resolution
string wind_map_json
---
# Response — flattened 17 x N trajectory (row-major)
bool success
int32 rows
int32 cols
float64[] trajectory
